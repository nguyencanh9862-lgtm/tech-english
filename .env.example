# Server Environment (Next.js + Express)
PORT=5000
NODE_ENV=development

# MySQL Database
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=cd_english

# Security & JWT
JWT_SECRET=cd_english_secret_key_2026_super_secure_random_string
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Admin Default Seed (Optional override)
ADMIN_DEFAULT_PASSWORD=admin123
