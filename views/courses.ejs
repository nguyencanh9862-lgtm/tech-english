<%- include('layouts/header', { title: 'Khóa Học Video - TechEnglish MVC' }) %>

<section style="margin-bottom: 30px;">
  <div style="margin-bottom:20px;">
    <h1 style="font-size: 26px; font-weight: 800; color: #1e293b; margin: 0 0 5px;">Khóa Học Video Tiếng Anh (Model &rarr; View)</h1>
    <p style="color: #64748b; margin: 0; font-size: 14px;">Hiển thị trực tiếp <%= courses.length %> khóa học từ <strong>Course Model</strong>.</p>
  </div>

  <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(320px, 1fr)); gap:25px;">
    <% courses.forEach(function(c) { %>
      <div style="background:#fff; border:1px solid #e2e8f0; border-radius:12px; overflow:hidden; box-shadow:0 2px 6px rgba(0,0,0,0.03);">
        <% if (c.thumbnail) { %>
          <img src="<%= c.thumbnail %>" alt="<%= c.title %>" style="width:100%; height:190px; object-fit:cover;">
        <% } %>
        <div style="padding:20px;">
          <div style="display:flex; gap:8px; margin-bottom:10px;">
            <span style="background:#fee2e2; color:#b91c1c; font-size:12px; padding:3px 10px; border-radius:12px; font-weight:700;"><%= c.category %></span>
            <span style="background:#e0e7ff; color:#4338ca; font-size:12px; padding:3px 10px; border-radius:12px; font-weight:700;"><%= c.level %></span>
          </div>
          <h2 style="font-size:18px; font-weight:700; margin:0 0 8px; color:#1e293b;"><%= c.title %></h2>
          <p style="font-size:14px; color:#64748b; margin:0 0 15px; line-height:1.5;"><%= c.description %></p>
          <div style="display:flex; justify-content:space-between; align-items:center; font-size:13px; color:#64748b; border-top:1px solid #f1f5f9; padding-top:12px;">
            <span><i class="fas fa-chalkboard-user"></i> <%= c.instructor %></span>
            <span><i class="fas fa-video"></i> <%= (c.lessons && c.lessons.length) || 1 %> bài học</span>
          </div>
        </div>
      </div>
    <% }); %>
  </div>
</section>

<%- include('layouts/footer') %>
