<%- include('layouts/header', { title: 'Bài Học Ngữ Pháp - TechEnglish MVC' }) %>

<section style="margin-bottom: 30px;">
  <div style="margin-bottom: 25px;">
    <h1 style="font-size: 26px; font-weight: 800; color: #1e293b; margin: 0 0 5px;">
      <i class="fas fa-book" style="color: #6366f1;"></i> Bài Học Ngữ Pháp (Model &rarr; View)
    </h1>
    <p style="color: #64748b; margin: 0; font-size: 14px;">
      Toàn bộ <%= grammarList.length %> bài học ngữ pháp được <strong>Controller</strong> truy vấn từ <strong>Grammar Model</strong> và truyền trực tiếp vào <strong>View</strong>.
    </p>
  </div>

  <div style="display: flex; flex-direction: column; gap: 20px;">
    <% grammarList.forEach(function(item) { %>
      <div style="background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 24px; box-shadow: 0 2px 6px rgba(0,0,0,0.03);">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; border-bottom: 1px solid #f1f5f9; padding-bottom: 10px;">
          <h2 style="font-size: 20px; font-weight: 800; color: #1e293b; margin: 0;">
            <i class="<%= item.icon || 'fas fa-circle-dot' %>" style="color: <%= item.color || '#6366f1' %>; margin-right: 8px;"></i>
            <%= item.title %>
          </h2>
          <% if (item.formula) { %>
            <code style="background: #eef2ff; color: #4f46e5; padding: 4px 12px; border-radius: 6px; font-weight: 700; font-size: 14px;">
              <%= item.formula %>
            </code>
          <% } %>
        </div>

        <p style="color: #475569; font-size: 15px; margin: 0 0 15px; line-height: 1.6;">
          <%= item.description %>
        </p>

        <% if (item.uses && item.uses.length > 0) { %>
          <div style="margin-bottom: 15px;">
            <h4 style="font-size: 14px; font-weight: 700; color: #0f172a; margin: 0 0 6px;">Cách dùng:</h4>
            <ul style="margin: 0; padding-left: 20px; color: #64748b; font-size: 14px; line-height: 1.5;">
              <% item.uses.forEach(function(u) { %>
                <li><%= u %></li>
              <% }); %>
            </ul>
          </div>
        <% } %>

        <% if (item.examples && item.examples.length > 0) { %>
          <div style="background: #f8fafc; border-radius: 8px; padding: 12px 16px; border-left: 4px solid #6366f1;">
            <h4 style="font-size: 13px; font-weight: 700; color: #4338ca; margin: 0 0 8px; text-transform: uppercase;">Ví dụ minh họa:</h4>
            <% item.examples.forEach(function(ex) { %>
              <div style="margin-bottom: 6px; font-size: 13px;">
                <span style="font-weight: 600; color: #1e293b;"><%= ex.en %></span>
                <span style="color: #64748b;"> &bull; <%= ex.vi %></span>
              </div>
            <% }); %>
          </div>
        <% } %>

        <% if (item.signals && item.signals.length > 0) { %>
          <div style="margin-top: 12px; font-size: 12px; color: #94a3b8;">
            <strong>Dấu hiệu nhận biết:</strong> <%= Array.isArray(item.signals) ? item.signals.join(', ') : item.signals %>
          </div>
        <% } %>
      </div>
    <% }); %>
  </div>
</section>

<%- include('layouts/footer') %>
