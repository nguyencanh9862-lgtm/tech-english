<%- include('layouts/header', { title: 'Từ Vựng Tiếng Anh - TechEnglish MVC' }) %>

<section style="margin-bottom: 30px;">
  <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:15px; margin-bottom:20px;">
    <div>
      <h1 style="font-size: 26px; font-weight: 800; color: #1e293b; margin: 0 0 5px;">Kho Từ Vựng (Model &rarr; View)</h1>
      <p style="color: #64748b; margin: 0; font-size: 14px;">Hiển thị trực tiếp <%= vocabList.length %> từ vựng được nạp từ <strong>Vocabulary Model</strong>.</p>
    </div>
    <a href="/mvc/vocab/new" style="background:#2563eb; color:#fff; text-decoration:none; padding:10px 18px; border-radius:8px; font-weight:700; font-size:14px;">
      <i class="fas fa-plus"></i> Thêm từ vựng mới
    </a>
  </div>

  <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(280px, 1fr)); gap:20px;">
    <% vocabList.forEach(function(item) { %>
      <div style="background:#fff; border:1px solid #e2e8f0; border-radius:12px; padding:20px; box-shadow:0 2px 6px rgba(0,0,0,0.03);">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
          <h2 style="margin:0; font-size:20px; font-weight:800; color:#0f172a;"><%= item.word %></h2>
          <span style="background:#dbeafe; color:#1e40af; padding:2px 8px; border-radius:12px; font-size:12px; font-weight:700;"><%= item.level %></span>
        </div>
        <p style="color:#64748b; font-size:13px; margin:0 0 8px;"><%= item.phonetic %> &bull; <span style="color:#2563eb; font-weight:600;"><%= item.pos %></span></p>
        <p style="font-weight:600; color:#1e293b; margin:0 0 10px; font-size:15px;"><%= item.meaning %></p>
        <% if (item.example) { %>
          <div style="background:#f8fafc; padding:10px; border-radius:6px; font-size:13px; color:#475569; border-left:3px solid #3b82f6; margin-bottom:8px;">
            <strong>Ví dụ:</strong> <%= item.example %>
            <% if (item.exampleVi) { %>
              <div style="color:#94a3b8; font-size:12px; margin-top:4px;"><%= item.exampleVi %></div>
            <% } %>
          </div>
        <% } %>
        <div style="font-size:11px; color:#94a3b8; text-transform:uppercase; font-weight:700;">Chủ đề: <%= item.category %></div>
      </div>
    <% }); %>
  </div>
</section>

<%- include('layouts/footer') %>
