<%- include('layouts/header', { title: 'Tin Tức Công Nghệ - TechEnglish MVC' }) %>

<section style="margin-bottom: 30px;">
  <div style="margin-bottom: 25px;">
    <h1 style="font-size: 26px; font-weight: 800; color: #1e293b; margin: 0 0 5px;">
      <i class="fas fa-newspaper" style="color: #f59e0b;"></i> Tin Tức Công Nghệ & Tiếng Anh Chuyên Ngành (Model &rarr; View)
    </h1>
    <p style="color: #64748b; margin: 0; font-size: 14px;">
      Toàn bộ bài viết được <strong>Controller</strong> truy vấn từ <strong>News Model</strong> và truyền trực tiếp vào <strong>View</strong> để render.
    </p>
  </div>

  <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 24px;">
    <% newsList.forEach(function(article) { %>
      <div style="background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden; box-shadow: 0 2px 6px rgba(0,0,0,0.03); display: flex; flex-direction: column;">
        <% if (article.image) { %>
          <img src="<%= article.image %>" alt="<%= article.title %>" style="width: 100%; height: 180px; object-fit: cover;">
        <% } %>
        <div style="padding: 20px; display: flex; flex-direction: column; flex-grow: 1;">
          <div style="display: flex; gap: 8px; margin-bottom: 10px;">
            <span style="background: #fef3c7; color: #b45309; font-size: 11px; padding: 2px 8px; border-radius: 10px; font-weight: 700;">
              <%= article.categoryLabel || article.category %>
            </span>
            <span style="color: #94a3b8; font-size: 12px;"><i class="far fa-clock"></i> <%= article.readTime || '5 phút đọc' %></span>
          </div>

          <h2 style="font-size: 17px; font-weight: 700; color: #0f172a; margin: 0 0 10px; line-height: 1.4;">
            <%= article.title %>
          </h2>

          <p style="color: #64748b; font-size: 13px; line-height: 1.5; margin: 0 0 15px; flex-grow: 1;">
            <%= article.summary %>
          </p>

          <% if (article.keyVocab && article.keyVocab.length > 0) { %>
            <div style="background: #f8fafc; border-radius: 6px; padding: 10px; margin-bottom: 15px;">
              <div style="font-size: 11px; font-weight: 700; color: #0284c7; text-transform: uppercase; margin-bottom: 4px;">Từ vựng cốt lõi:</div>
              <div style="font-size: 12px; color: #334155;">
                <% article.keyVocab.slice(0, 3).forEach(function(v, idx) { %>
                  <span><strong><%= v.word %></strong> (<%= v.meaning %>)<%= idx < Math.min(article.keyVocab.length, 3) - 1 ? ', ' : '' %></span>
                <% }); %>
              </div>
            </div>
          <% } %>

          <div style="display: flex; justify-content: space-between; align-items: center; font-size: 12px; color: #94a3b8; border-top: 1px solid #f1f5f9; padding-top: 12px;">
            <span><i class="far fa-user"></i> <%= article.author || 'Ban biên tập' %></span>
            <span><i class="far fa-eye"></i> <%= article.views || 0 %> lượt xem</span>
          </div>
        </div>
      </div>
    <% }); %>
  </div>
</section>

<%- include('layouts/footer') %>
