      <a href="/mvc" class="nav-logo" style="text-decoration:none; display:flex; align-items:center; gap:8px;">
        <i class="fas fa-laptop-code" style="color:#2563eb; font-size:24px;"></i>
        <span style="font-size:22px; font-weight:800; color:#1e293b;">Tech<span style="color:#2563eb;">English</span></span>
        <span style="background:#dbeafe; color:#1e40af; font-size:11px; padding:2px 8px; border-radius:10px; font-weight:700;">MVC</span>
      </a>

      <nav style="display:flex; gap:6px; font-weight:600; flex-wrap:wrap; align-items:center;">
        <a href="/mvc" class="mvc-nav-link"><i class="fas fa-house"></i> Trang chủ</a>
        <a href="/mvc/vocab" class="mvc-nav-link"><i class="fas fa-book-open"></i> Từ vựng</a>
        <a href="/mvc/courses" class="mvc-nav-link"><i class="fab fa-youtube"></i> Khóa học</a>
        <a href="/mvc/grammar" class="mvc-nav-link"><i class="fas fa-book"></i> Ngữ pháp</a>
        <a href="/mvc/quiz" class="mvc-nav-link"><i class="fas fa-circle-question"></i> Quiz</a>
        <a href="/mvc/news" class="mvc-nav-link"><i class="fas fa-newspaper"></i> Tin tức</a>
        <a href="/mvc/it" class="mvc-nav-link"><i class="fas fa-terminal"></i> IT Academy</a>
        <a href="/mvc/admin" class="mvc-nav-link" style="color:#2563eb;"><i class="fas fa-shield-halved"></i> Admin MVC</a>
        <a href="/index.html" class="mvc-nav-link" style="background:#f8fafc; border:1px solid #e2e8f0;"><i class="fas fa-desktop"></i> SPA App</a>
      </nav>
    </div>
  </header>
  <main class="container" style="max-width:1200px; margin:25px auto; padding:0 15px;">
